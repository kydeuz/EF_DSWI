@model IEnumerable<ClinicaSalud.Models.Paciente>
@{
    ViewData["Title"] = "listadopacientes";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item active" aria-current="page"></li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">Pacientes</h2>
    <a asp-controller="Pacientes" asp-action="Nuevo" class="btn btn-primary px-3">
        <i class="bi bi-plus-lg me-1"></i> Nuevo paciente
    </a>
</div>

@if (TempData["mensaje"] != null)
{
    <div class="alert alert-info">@TempData["mensaje"]</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <form asp-controller="Pacientes" asp-action="listadopacientes" method="get" class="input-group" style="max-width: 380px;">
            <input type="text" name="texto" value="@ViewBag.texto" class="form-control" placeholder="Buscar por nombre, DNI o teléfono..." />
            <button class="btn btn-primary" type="submit"><i class="bi bi-search"></i> Buscar</button>
        </form>

        <div class="table-responsive">
            <table class="table align-middle table-hover">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>@Html.DisplayNameFor(model => model.PacienteId)</th>
                        <th>@Html.DisplayNameFor(model => model.DNI)</th>
                        <th>Nombre</th>
                        <th>@Html.DisplayNameFor(model => model.FechaNacimiento)</th>
                        <th>@Html.DisplayNameFor(model => model.Sexo)</th>
                        <th>@Html.DisplayNameFor(model => model.Telefono)</th>
                        <th>@Html.DisplayNameFor(model => model.Correo)</th>
                        <th>@Html.DisplayNameFor(model => model.Direccion)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">@Html.DisplayFor(modelItem => item.PacienteId)</td>
                            <td>@Html.DisplayFor(modelItem => item.DNI)</td>
                            <td class="fw-semibold">@item.Nombres @item.Apellidos</td>
                            <td>@item.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge rounded-pill bg-light text-dark border">
                                    @(item.Sexo == "M" ? "Masculino" : "Femenino")
                                </span>
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                            <td>@Html.DisplayFor(modelItem => item.Correo)</td>
                            <td>@Html.DisplayFor(modelItem => item.Direccion)</td>
                            <td class="text-end">
                                <a asp-controller="HistorialMedico" asp-action="Listado" asp-route-pacienteId="@item.PacienteId"
                                   class="btn btn-sm btn-outline-secondary" title="Historial médico">
                                    <i class="bi bi-clipboard2-pulse"></i>
                                </a>
                                <a asp-controller="Pacientes" asp-action="Edit" asp-route-id="@item.PacienteId"
                                   class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-controller="Pacientes" asp-action="Delete" asp-route-id="@item.PacienteId"
                                   class="btn btn-sm btn-outline-danger" title="Eliminar"
                                   onclick="return confirm('¿Eliminar este paciente?');">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Any())
        {
            <nav aria-label="Paginación de pacientes">
                <ul class="pagination justify-content-center mb-0">
                    @for (int i = 0; i < (int)ViewBag.paginas; i++)
                    {
                        <li class="page-item">
                            @Html.ActionLink((i + 1).ToString(), "listadopacientes", "Pacientes", new { p = i, texto = ViewBag.texto }, new { @class = "page-link" })
                        </li>
                    }
                </ul>
            </nav>
        }
        else
        {
            <p class="text-muted text-center mb-0">No hay pacientes registrados todavía.</p>
        }

    </div>
</div>
