@model ClinicaSalud.Models.Medico

@{
    ViewData["Title"] = "Nuevo médico";
    Layout = "~/Views/Shared/_LayoutMaster.cshtml";
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-controller="Medicos" asp-action="listadomedicos">Médicos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Nuevo médico</li>
    </ol>
</nav>

<h2 class="fw-bold mb-4">Nuevo médico</h2>

@if (TempData["mensaje"] != null)
{
    <div class="alert alert-info">@TempData["mensaje"]</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">

        <form asp-controller="Medicos" asp-action="Registrar" method="post">

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Nombres" class="form-label">Nombres *</label>
                    <input asp-for="Nombres" class="form-control" placeholder="Ingrese nombres" required maxlength="100" />
                    <span asp-validation-for="Nombres" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Apellidos" class="form-label">Apellidos *</label>
                    <input asp-for="Apellidos" class="form-control" placeholder="Ingrese apellidos" required maxlength="100" />
                    <span asp-validation-for="Apellidos" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="EspecialidadId" class="form-label">Especialidad *</label>
                    <select asp-for="EspecialidadId" class="form-select" required
                            asp-items="@(new SelectList(ViewBag.Especialidades, "EspecialidadId", "Nombre"))">
                        <option value="">Seleccione</option>
                    </select>
                    <span asp-validation-for="EspecialidadId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label asp-for="Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control" placeholder="Ingrese teléfono" maxlength="20" />
                    <span asp-validation-for="Telefono" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Correo" class="form-label">Correo</label>
                    <input asp-for="Correo" type="email" class="form-control" placeholder="Ingrese correo electrónico" maxlength="100" />
                    <span asp-validation-for="Correo" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Medicos" asp-action="listadomedicos" class="btn btn-outline-secondary px-4">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4">Guardar</button>
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
