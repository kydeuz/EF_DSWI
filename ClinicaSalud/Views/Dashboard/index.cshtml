@model Dashboard
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_LayoutMaster";
}

<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-people fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Pacientes</div>
                    <div class="fs-4 fw-bold">@Model.TotalPacientes</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-person-badge fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Médicos</div>
                    <div class="fs-4 fw-bold">@Model.TotalMedicos</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-purple bg-opacity-10 text-primary d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-calendar-check fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Citas hoy</div>
                    <div class="fs-4 fw-bold">@Model.CitasHoy</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Citas pendientes</div>
                    <div class="fs-4 fw-bold">@Model.CitasPendientes</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3">Citas de hoy</h5>

        <div class="table-responsive">
            <table class="table align-middle table-hover">
                <thead>
                    <tr class="text-muted small text-uppercase">
                        <th>Hora</th>
                        <th>Paciente</th>
                        <th>Médico</th>
                        <th>Especialidad</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CitasDeHoy)
                    {
                        <tr>
                            <td>@item.Hora.ToString(@"hh\:mm")</td>
                            <td class="fw-semibold">@item.Paciente</td>
                            <td>@item.Medico</td>
                            <td>@item.Especialidad</td>
                            <td>
                                @{
                                    string badgeClass = item.Estado switch
                                    {
                                        "Atendida" => "text-bg-success",
                                        "Cancelada" => "text-bg-danger",
                                        _ => "text-bg-warning"
                                    };
                                }
                                <span class="badge rounded-pill @badgeClass">@item.Estado</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!Model.CitasDeHoy.Any())
        {
            <p class="text-muted text-center mb-0">No hay citas agendadas para hoy.</p>
        }

        <a asp-controller="Citas" asp-action="listadocitas" class="d-inline-block mt-2">Ver todas las citas</a>
    </div>
</div>
